<Project>
  <!-- Applied automatically to every project under this folder. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning is a bug you haven't fixed yet. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Fail the build if any package (direct or indirect) has a known vulnerability. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>
</Project>